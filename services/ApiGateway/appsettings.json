{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  },
  "ReverseProxy": {
    "Routes": {
      "authRoute": {
        "ClusterId": "ticketServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "ticketsRoute": {
        "ClusterId": "ticketServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/tickets/{**catch-all}" }
      },
      "usersRoute": {
        "ClusterId": "ticketServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/users/{**catch-all}" }
      },
      "responsesRoute": {
        "ClusterId": "responseServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/responses/{**catch-all}" }
      },
      "metricsRoute": {
        "ClusterId": "notificationServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/metrics/{**catch-all}" }
      },
      "notificationsRoute": {
        "ClusterId": "notificationServiceCluster",
        "Timeout": "00:00:10",
        "Match": { "Path": "/api/notifications/{**catch-all}" }
      }
    },
    "Clusters": {
      "ticketServiceCluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5101" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "responseServiceCluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5102" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      },
      "notificationServiceCluster": {
        "Destinations": {
          "destination1": { "Address": "http://localhost:5103" }
        },
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Interval": "00:00:10",
            "Timeout": "00:00:05",
            "Policy": "ConsecutiveFailures",
            "Path": "/health/ready"
          }
        }
      }
    }
  }
}
