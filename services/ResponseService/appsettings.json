{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // ConnectionStrings:DefaultConnection, Jwt:Secret and RabbitMq:Username/Password are
  // deliberately blank here — never commit real values. docker compose supplies them
  // via env vars (ConnectionStrings__DefaultConnection, Jwt__Secret, RabbitMq__*); for
  // running this service directly with `dotnet run`, set the same keys with
  // `dotnet user-secrets set "Jwt:Secret" "..."` (etc.) instead of editing this file.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Secret": "",
    "Issuer": "SupportTicketing",
    "Audience": "SupportTicketing.Clients",
    "AccessTokenMinutes": 120
  },
  "RabbitMq": {
    "Host": "localhost",
    "Username": "",
    "Password": ""
  },
  "Cors": {
    "AllowedOrigin": "http://localhost:4200"
  }
}
