# Copy to .env and fill in real values before running docker compose.

# Shared JWT signing key — same value must be used by every service since each
# validates tokens locally rather than calling back to an issuer.
JWT_SECRET=

# RabbitMQ credentials (used by rabbitmq container and every .NET service's RabbitMq__* config)
RABBITMQ_USER=
RABBITMQ_PASS=

# SQL Server SA password — must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit or symbol) or the container will fail to start.
MSSQL_SA_PASSWORD=

# Optional local support-agent account, meant for local/E2E use. Set both values to
# enable it — TicketService seeds it in any environment where both are non-empty,
# there is no ASPNETCORE_ENVIRONMENT gate, so treat it as a real account, not a dev-only stub.
LOCAL_AGENT_EMAIL=
LOCAL_AGENT_PASSWORD=
# Optional display name for the local support agent.
LOCAL_AGENT_FULL_NAME=Local Support Agent

# Optional initial admin account. Set both values to enable it. Seeded by
# TicketService in every environment (same as LOCAL_AGENT_* above, not special-cased).
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
# Optional display name for the initial admin.
INITIAL_ADMIN_FULL_NAME=Initial Admin
