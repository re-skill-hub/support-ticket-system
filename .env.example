# Copy to .env and fill in real values before running docker compose.

# Shared JWT signing key — same value must be used by every service since each
# validates tokens locally rather than calling back to an issuer.
JWT_SECRET=

# RabbitMQ credentials (used by rabbitmq container and every .NET service's RabbitMq__* config)
RABBITMQ_USER=
RABBITMQ_PASS=

# SQL Server SA password — must satisfy SQL Server's complexity policy
# (8+ chars, upper+lower+digit or symbol) or the container will fail to start.
MSSQL_SA_PASSWORD=

# Optional local-only support-agent account. Set both values to enable it.
# This account is seeded only by TicketService when ASPNETCORE_ENVIRONMENT=Development.
LOCAL_AGENT_EMAIL=
LOCAL_AGENT_PASSWORD=
# Optional display name for the local support agent.
LOCAL_AGENT_FULL_NAME=Local Support Agent
